#!/bin/sh

ACTION="$1"
WG_IF="$2"

if [ -z "$WG_IF" ] || [ -z "$ACTION" ]; then
    echo "Usage: $0 {up|down} <interface>"
    exit 1
fi

WG_HOME="/data/wireguard"
WG_CONF="$WG_HOME/conf/${WG_IF}.conf"
WG_BIN="$WG_HOME/bin/wireguard-go"
WG_CMD="$WG_HOME/bin/wg"
export WG_QUICK_USERSPACE_IMPLEMENTATION=wireguard-go

# WAN interface connected to upstream router
WAN_IF="eth0"
# LAN bridge interface for local network
LAN_IF="br-lan"

# ==================================
# WAN bypass: peer IPs that should go through WAN directly instead of tunnel
# Example: 10.10.10.2/32
# ==================================
WAN_BYPASS_IPS=""

kill_wg() {
    for pid in $(ps | grep "[w]ireguard-go $WG_IF" | awk '{print $1}'); do
        kill "$pid" 2>/dev/null
    done
}

extract_addrs() {
    awk -F= '/^Address[[:space:]]*=/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' "$WG_CONF" | tr ',' ' '
}

extract_mtu() {
    awk -F= '/^MTU[[:space:]]*=/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' "$WG_CONF"
}

extract_routes() {
    awk -F= '/^AllowedIPs[[:space:]]*=/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' "$WG_CONF" | tr ',' ' '
}

generate_tmp_conf() {
    TMP=$(mktemp)
    awk '{
        if ($0 ~ /^Address[[:space:]]*=/) next
        if ($0 ~ /^MTU[[:space:]]*=/) next
        if ($0 ~ /^DNS[[:space:]]*=/) next
        print
    }' "$WG_CONF" > "$TMP"
    echo "$TMP"
}

# ==================================
# Manage iptables rules
# ==================================
manage_iptables() {
    local ACT="$1"
    if [ "$ACT" = "add" ]; then
        iptables -t nat -A POSTROUTING -o "$WG_IF" -j MASQUERADE && \
            echo "[iptables] added: NAT MASQUERADE on $WG_IF"
        iptables -I FORWARD -i "$WAN_IF" -o "$LAN_IF" -j ACCEPT && \
            echo "[iptables] added: FORWARD $WAN_IF -> $LAN_IF ACCEPT"
        iptables -I FORWARD -i "$LAN_IF" -o "$WAN_IF" -j ACCEPT && \
            echo "[iptables] added: FORWARD $LAN_IF -> $WAN_IF ACCEPT"
        iptables -I INPUT -i "$WAN_IF" -j ACCEPT && \
            echo "[iptables] added: INPUT $WAN_IF ACCEPT"
    elif [ "$ACT" = "del" ]; then
        iptables -t nat -D POSTROUTING -o "$WG_IF" -j MASQUERADE 2>/dev/null && \
            echo "[iptables] removed: NAT MASQUERADE on $WG_IF"
        iptables -D FORWARD -i "$WAN_IF" -o "$LAN_IF" -j ACCEPT 2>/dev/null && \
            echo "[iptables] removed: FORWARD $WAN_IF -> $LAN_IF ACCEPT"
        iptables -D FORWARD -i "$LAN_IF" -o "$WAN_IF" -j ACCEPT 2>/dev/null && \
            echo "[iptables] removed: FORWARD $LAN_IF -> $WAN_IF ACCEPT"
        iptables -D INPUT -i "$WAN_IF" -j ACCEPT 2>/dev/null && \
            echo "[iptables] removed: INPUT $WAN_IF ACCEPT"
    fi
}

# ==================================
# WAN bypass: peer IPs that go through WAN directly instead of tunnel
# ==================================
manage_wan_bypass() {                     
    local ACT="$1"                                                                                       
    local WAN_GW                    
    WAN_GW=$(ip route show default | awk '{print $3}' | head -n1)                                           
    if [ -z "$WAN_GW" ]; then                 
        echo "[wan-bypass] Warning: cannot detect default gateway, skipping"            
        return                            
    fi                                                                                                   
    for ipcidr in $WAN_BYPASS_IPS; do
        if [ "$ACT" = "add" ]; then                                                                         
            ip route add "$ipcidr" via "$WAN_GW" 2>/dev/null && \
                echo "[wan-bypass] added: $ipcidr via $WAN_GW" || \                     
                echo "[wan-bypass] already exists or failed: $ipcidr via $WAN_GW"
        elif [ "$ACT" = "del" ]; then                                                                    
            ip route del "$ipcidr" via "$WAN_GW" 2>/dev/null && \
                echo "[wan-bypass] removed: $ipcidr via $WAN_GW" || \                                       
                echo "[wan-bypass] not found or failed: $ipcidr" 
        fi                                                                              
    done                                                                         
}

wg_quick_up() {
    MTU=$(extract_mtu)
    ADDR_LIST=$(extract_addrs)
    ROUTE_LIST=$(extract_routes)
    kill_wg
    ip tuntap add dev "$WG_IF" mode tun 2>/dev/null || echo "$WG_IF exists"
    ip link set "$WG_IF" up
    [ -n "$MTU" ] && ip link set mtu "$MTU" dev "$WG_IF"
    "$WG_BIN" "$WG_IF" &
    sleep 1
    TMP_CONF=$(generate_tmp_conf)
    "$WG_CMD" setconf "$WG_IF" "$TMP_CONF"
    rm -f "$TMP_CONF"
    for ipaddr in $ADDR_LIST; do ip addr add "$ipaddr" dev "$WG_IF" 2>/dev/null; done
    for r in $ROUTE_LIST; do
        case $r in
            *:* ) ip -6 route add "$r" dev "$WG_IF" 2>/dev/null ;;
            * )   ip route add "$r" dev "$WG_IF" 2>/dev/null ;;
        esac
    done
    manage_iptables add
    manage_wan_bypass add
    echo "$WG_IF up"
    "$WG_CMD" show "$WG_IF"
}

wg_quick_down() {
    manage_wan_bypass del
    manage_iptables del
    kill_wg
    ADDR_LIST=$(extract_addrs)
    ROUTE_LIST=$(extract_routes)
    for ipaddr in $ADDR_LIST; do ip addr del "$ipaddr" dev "$WG_IF" 2>/dev/null; done
    for r in $ROUTE_LIST; do
        case $r in
            *:* ) ip -6 route del "$r" dev "$WG_IF" 2>/dev/null ;;
            * )   ip route del "$r" dev "$WG_IF" 2>/dev/null ;;
        esac
    done
    ip link set "$WG_IF" down 2>/dev/null
    ip tuntap del dev "$WG_IF" mode tun 2>/dev/null
    echo "$WG_IF down"
}

case "$ACTION" in
    up) wg_quick_up ;;
    down) wg_quick_down ;;
    *) echo "Usage: $0 {up|down} <interface>" ; exit 1 ;;
esac
